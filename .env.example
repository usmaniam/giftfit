YOUCAM_API_KEY=
DEMO_MODE=true             # true = cached demo renders, no key needed. Set false for live YouCam
YOUCAM_EXPERIMENTAL=false  # true enables adapters with unverified request bodies (costs credits)
# YOUCAM_BASE_URL=         # override for the local mock: http://localhost:4010

# Database. Local: `docker compose up -d db`. Supabase: use the TRANSACTION POOLER string (port 6543) at runtime;
# run `pnpm db:push` / `pnpm seed` with the DIRECT or session-pooler string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/giftfit

# File storage. Local disk by default; switches to Supabase Storage automatically when both Supabase vars are set
# (required on Vercel). Bucket is created as private by `pnpm seed`.
STORAGE_DIR=./storage
STORAGE_DRIVER=local       # local | supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY= # server-side only. Never prefix with NEXT_PUBLIC_
SUPABASE_BUCKET=giftfit

GEMINI_API_KEY=            # free key from Google AI Studio
GIFT_AGENT_MODEL=          # a current Flash / Flash-Lite model ID from AI Studio
AGENT_ENABLED=true         # false = deterministic ranking only
APP_URL=http://localhost:3000   # on Vercel this defaults to the production URL if unset
INVITE_TOKEN_SECRET=       # required in production: openssl rand -hex 24
CRON_SECRET=               # required for the daily purge cron: openssl rand -hex 24
REPORT_EMAIL=              # optional: shows a "Report misuse" link in the footer
