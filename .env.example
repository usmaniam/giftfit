YOUCAM_API_KEY=
DEMO_MODE=true             # true = cached demo renders, no key needed. Set false for live YouCam
YOUCAM_EXPERIMENTAL=false  # true enables adapters with unverified request bodies (costs credits)
# YOUCAM_BASE_URL=         # override for the local mock: http://localhost:4010
DATABASE_URL=file:./local.db
STORAGE_DIR=./storage
STORAGE_DRIVER=local
GEMINI_API_KEY=            # free key from Google AI Studio
GIFT_AGENT_MODEL=          # a current Flash / Flash-Lite model ID from AI Studio
AGENT_ENABLED=true         # false = deterministic ranking only
APP_URL=http://localhost:3000
INVITE_TOKEN_SECRET=          # required in production: openssl rand -hex 24
REPORT_EMAIL=            # optional: shows a "Report misuse" link in the footer
