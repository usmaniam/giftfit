{
  "name": "giftfit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "drizzle-kit push",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "db:reset": "rm -f local.db local.db-* && pnpm db:push --force && pnpm seed",
    "check:secrets": "sh scripts/check-secrets.sh"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "better-sqlite3": "^11.5.0",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.38.0",
    "next": "^15.1.0",
    "postcss": "^8.5.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "protobufjs",
      "@google/genai"
    ]
  }
}
